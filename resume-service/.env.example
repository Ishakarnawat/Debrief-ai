# Environment Configuration for Resume Screening Microservice
PORT=8001
ENVIRONMENT=development

# Database URL:
# For local zero-dependency run: sqlite:///./ats_screening.db
# For production Docker/PostgreSQL: postgresql://postgres:postgres@postgres:5432/ats_db
DATABASE_URL=sqlite:///./ats_screening.db

# Google Gemini API Key (Required for Phase 3 GenAI evaluation)
GEMINI_API_KEY=
