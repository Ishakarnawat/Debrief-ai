# ==============================================================================
# Debrief.ai — Environment Configuration Template
# Copy this file to .env before launching docker-compose or local services.
# ==============================================================================

# ─── 1. Authentication (Clerk) ────────────────────────────────────────────────
# Get your keys at https://clerk.com (Leave blank for automatic local demo auth)
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# ─── 2. AI & Large Language Models (OpenAI / Gemini) ──────────────────────────
OPENAI_API_KEY=

# ─── 3. Cloud Storage (AWS S3) [Optional - Defaults to local streaming] ───────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ─── 4. Cloud Storage (Cloudinary) [Optional] ─────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── 5. Service URLs ─────────────────────────────────────────────────────────
PORT=5000
VITE_API_URL=http://localhost:5000
ML_SERVICE_URL=http://localhost:8000
MONGO_URI=mongodb://localhost:27017/debrief-ai
